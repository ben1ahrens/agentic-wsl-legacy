#!/usr/bin/env bash
# wopen — open a URL, file, or directory from WSL in the default Windows app.
#
# Handles:
#   wopen https://example.com
#   wopen --new-window https://example.com
#   wopen -- https://example.com
#   wopen ./some-file.txt
#   wopen .
#
# Designed to work as BROWSER/wslview replacement for CLI tools that may pass
# browser-style flags before the actual URL.

set -euo pipefail

usage() {
  echo "usage: wopen <url|file|dir>" >&2
  exit 1
}

[ "$#" -gt 0 ] || usage

log_debug() {
  # Uncomment for debugging:
  # printf 'wopen args:' >> /tmp/wopen.log
  # printf ' [%s]' "$@" >> /tmp/wopen.log
  # printf '\n' >> /tmp/wopen.log
  :
}

log_debug "$@"

target=""

# 1. Prefer the first URL-like argument anywhere in the command line.
for arg in "$@"; do
  case "$arg" in
    http://*|https://*|mailto:*|file://*)
      target="$arg"
      break
      ;;
  esac
done

# 2. If no URL was found, use the first non-option argument.
#    This avoids treating flags like --new-window as paths.
if [ -z "$target" ]; then
  for arg in "$@"; do
    case "$arg" in
      --)
        continue
        ;;
      -*)
        continue
        ;;
      *)
        target="$arg"
        break
        ;;
    esac
  done
fi

# 3. If all arguments were flags, fail cleanly instead of opening File Explorer.
if [ -z "$target" ]; then
  echo "wopen: no URL, file, or directory argument found" >&2
  exit 1
fi

# 4. Convert Linux paths to Windows paths, but leave URLs alone.
case "$target" in
  http://*|https://*|mailto:*)
    loc="$target"
    ;;
  file://*)
    # Keep file:// URLs as-is. Some apps/tools intentionally pass these.
    loc="$target"
    ;;
  *)
    if command -v wslpath >/dev/null 2>&1; then
      loc="$(wslpath -w "$(realpath -m "$target")")"
    else
      echo "wopen: wslpath not found" >&2
      exit 1
    fi
    ;;
esac

# 5. Open using Windows' default handler.
#
# cmd.exe /c start is usually better than explorer.exe for URLs because it asks
# Windows to use the registered default browser/app directly.
#
# The empty string after start is the required window-title placeholder.
cmd.exe /c start "" "$loc" >/dev/null 2>&1 &

exit 0
